# This file is committed to git. Never put real values in it -- put those in
# .env, which is gitignored.

# Frontend
VITE_API_BASE_URL=http://localhost:3001/api

# Backend / Supabase
# VITE_SUPABASE_URL is read by the backend only, as a fallback for SUPABASE_URL.
# The frontend no longer talks to Supabase directly, so no anon key is needed.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# App auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=3001
NODE_ENV=development
SEED_DEFAULT_ADMIN=true
SEED_SAMPLE_CUSTOMERS=true
DEV_ADMIN_NAME=Admin User
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=admin123
DEV_ADMIN_ROLE=admin
ADMIN_BOOTSTRAP_NAME=Production Admin
ADMIN_BOOTSTRAP_EMAIL=admin@yourcompany.com
# At least 10 characters, at least 4 distinct, and not on the common-password
# list. The API enforces the same rule on every password it accepts.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_BOOTSTRAP_ROLE=super-admin

# Optional WhatsApp / Twilio settings
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
FACEBOOK_APP_ID=your_facebook_app_id
# Required to accept delivery-status callbacks: the webhook verifies an HMAC
# signature with it, and rejects every callback if it is unset.
FACEBOOK_APP_SECRET=your_facebook_app_secret
# Any string you choose; must match what you enter in the Meta dashboard when
# subscribing the webhook.
WHATSAPP_VERIFY_TOKEN=

# Email delivery
EMAIL_FROM=StreamOps IPTV <no-reply@yourcompany.com>
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Frontend origin used by backend CORS.
# In production this is the ONLY origin accepted -- the localhost aliases that
# development allows are not applied when NODE_ENV=production, and the server
# refuses to start if this still points at localhost.
FRONTEND_URL=http://localhost:5173
# Comma separated, for a deployment served from more than one hostname.
ADDITIONAL_FRONTEND_URLS=

# Number of reverse proxies in front of this server. The rate limiters key on
# the client IP; behind a proxy with this left at 0 every client collapses into
# one bucket.
TRUST_PROXY_HOPS=0

# Default currency for new records. Existing rows carry their own.
DEFAULT_CURRENCY=USD

# How long a temporary portal password stays valid.
PORTAL_PASSWORD_TTL_HOURS=72

# Scheduler: expires lapsed subscriptions and sends renewal reminders.
# Defaults to on in production, off in development so a dev machine does not
# message real customers.
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 2 * * *
SCHEDULER_TIMEZONE=UTC
RENEWAL_REMINDER_DAYS=7,3,1
RENEWAL_REMINDER_CHANNELS=email
MAX_REMINDERS_PER_RUN=500

# debug | info | warn | error. Defaults to info in production, debug otherwise.
LOG_LEVEL=

# Debug
DEBUG_WHATSAPP=false
